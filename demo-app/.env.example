# Copy this file to .env and add your configuration

# ============================================================================
# ROBOFLOW INTEGRATION (Required for Segmentation)
# ============================================================================
# Python backend URL (Flask server that connects to Roboflow)
# Default: http://localhost:5000
VITE_PYTHON_BACKEND_URL=http://localhost:5000

# NOTE: Roboflow API key is configured in python-backend/.env
# See python-backend/README.md for setup instructions


# ============================================================================
# OPENAI API (Optional - for enhanced features)
# ============================================================================
# OpenAI API Key (for content-aware fill and prompt parsing)
# Get from: https://platform.openai.com/api-keys
# Features enabled:
#   - AI-powered content-aware fill (DALL-E)
#   - Natural language prompt parsing (GPT)
# VITE_OPENAI_API_KEY=sk_your_openai_key_here


# ============================================================================
# DEPRECATED - NO LONGER USED
# ============================================================================
# The following keys are no longer needed (replaced by Roboflow):
# VITE_HUGGING_FACE_API_KEY - Removed (use Roboflow instead)
# VITE_PHOTOROOM_API_KEY - Removed (use Roboflow workflow instead)
